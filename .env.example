# Salin file ini menjadi .env lalu isi nilainya.
# Jangan commit .env yang berisi API key asli.

# API key MyAI Nexus dari https://console.myai.nexus
MYAI_API_KEY=

# Base URL endpoint OpenAI/DeepSeek-compatible MyAI Nexus.
# Contoh: https://api.myai.nexus/v1
# Biarkan kosong untuk memakai default plugin.
MYAI_BASE_URL=https://api.myai.nexus/v1
